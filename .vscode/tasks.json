      "options": {
        "cwd": "${workspaceFolder}/extensions/julia-profiler"
      },
      "group": "build",
      "problemMatcher": "$esbuild"
    },
    {
      "label": "build hw-security",
      "type": "shell",
      "command": "npm run build",
      "options": {
        "cwd": "${workspaceFolder}/extensions/hw-security"
      },
      "group": "build",
      "problemMatcher": "$esbuild"
    }
  ]
}