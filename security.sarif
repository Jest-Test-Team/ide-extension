{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "jest-security",
          "version": "0.2.0",
          "informationUri": "https://github.com/Jest-Test-Team/ide-extension",
          "rules": [
            {
              "id": "edr/missing-cleanup",
              "name": "Resource acquired without matching release",
              "shortDescription": {
                "text": "Resource acquired without matching release"
              },
              "fullDescription": {
                "text": "Engine sessions, ETW sessions/consumers, ES clients and kernel callouts outlive their creator if they are not released: ETW sessions keep running after the process exits (64-session limit), unregistered WFP callouts crash the system after driver unload, leaked ES clients keep receiving (and blocking on) AUTH events."
              },
              "helpUri": "https://learn.microsoft.com/en-us/windows/win32/fwp/windows-filtering-platform-start-page",
              "help": {
                "text": "Windows Filtering Platform documentation <https://learn.microsoft.com/en-us/windows/win32/fwp/windows-filtering-platform-start-page>\nEvent Tracing for Windows documentation <https://learn.microsoft.com/en-us/windows/win32/etw/about-event-tracing>\nApple Endpoint Security documentation <https://developer.apple.com/documentation/endpointsecurity>"
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "tags": []
              }
            },
            {
              "id": "edr/unchecked-status",
              "name": "Ignored status from security API",
              "shortDescription": {
                "text": "Ignored status from security API"
              },
              "fullDescription": {
                "text": "WFP, ETW and Endpoint Security report failures (missing entitlement, access denied, session exists, too many clients) only through return values. An agent that ignores them silently runs without protection."
              },
              "helpUri": "https://cwe.mitre.org/data/definitions/252.html",
              "help": {
                "text": "CWE-252: Unchecked Return Value <https://cwe.mitre.org/data/definitions/252.html>"
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "tags": []
              }
            },
            {
              "id": "edr/deprecated-api",
              "name": "Deprecated Endpoint Security API",
              "shortDescription": {
                "text": "Deprecated Endpoint Security API"
              },
              "fullDescription": {
                "text": "Deprecated Endpoint Security API"
              },
              "helpUri": "https://developer.apple.com/documentation/endpointsecurity",
              "help": {
                "text": "Apple Endpoint Security documentation <https://developer.apple.com/documentation/endpointsecurity>"
              },
              "defaultConfiguration": {
                "level": "note"
              },
              "properties": {
                "tags": []
              }
            },
            {
              "id": "edr/esf-auth-no-response",
              "name": "AUTH events subscribed without a response path",
              "shortDescription": {
                "text": "AUTH events subscribed without a response path"
              },
              "fullDescription": {
                "text": "Every AUTH message must be answered with es_respond_auth_result / es_respond_flags_result before its deadline; otherwise the system terminates the client (and the operation is held until then)."
              },
              "helpUri": "https://developer.apple.com/documentation/endpointsecurity",
              "help": {
                "text": "Apple Endpoint Security: es_respond_auth_result <https://developer.apple.com/documentation/endpointsecurity>\nApple Endpoint Security documentation <https://developer.apple.com/documentation/endpointsecurity>"
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "tags": []
              }
            },
            {
              "id": "edr/wfp-server-name",
              "name": "FwpmEngineOpen0 serverName must be NULL",
              "shortDescription": {
                "text": "FwpmEngineOpen0 serverName must be NULL"
              },
              "fullDescription": {
                "text": "FwpmEngineOpen0 serverName must be NULL"
              },
              "helpUri": "https://learn.microsoft.com/en-us/windows/win32/api/fwpmu/nf-fwpmu-fwpmengineopen0",
              "help": {
                "text": "Windows Filtering Platform: FwpmEngineOpen0 <https://learn.microsoft.com/en-us/windows/win32/api/fwpmu/nf-fwpmu-fwpmengineopen0>"
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "tags": []
              }
            },
            {
              "id": "edr/wfp-transaction",
              "name": "WFP policy changes outside a transaction / without abort",
              "shortDescription": {
                "text": "WFP policy changes outside a transaction / without abort"
              },
              "fullDescription": {
                "text": "Several FwpmXxxAdd calls without FwpmTransactionBegin0 can leave a half-applied policy (e.g. a sublayer without its filters) when one fails; a transaction without FwpmTransactionAbort0 leaves the session locked on error paths."
              },
              "helpUri": "https://learn.microsoft.com/en-us/windows/win32/api/fwpmu/nf-fwpmu-fwpmtransactionbegin0",
              "help": {
                "text": "Windows Filtering Platform: FwpmTransactionBegin0 <https://learn.microsoft.com/en-us/windows/win32/api/fwpmu/nf-fwpmu-fwpmtransactionbegin0>\nWindows Filtering Platform: FwpmTransactionAbort0 <https://learn.microsoft.com/en-us/windows/win32/api/fwpmu/nf-fwpmu-fwpmtransactionabort0>"
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "tags": []
              }
            },
            {
              "id": "edr/etw-broad-enable",
              "name": "Provider enabled at VERBOSE / all keywords",
              "shortDescription": {
                "text": "Provider enabled at VERBOSE / all keywords"
              },
              "fullDescription": {
                "text": "Verbose level with all keywords (e.g. Microsoft-Windows-Kernel-*) produces very high event rates; consumers fall behind and the session drops events, creating blind spots. Enable only the keywords the detection needs."
              },
              "helpUri": "https://learn.microsoft.com/en-us/windows/win32/api/evntrace/nf-evntrace-enabletraceex2",
              "help": {
                "text": "Event Tracing for Windows: EnableTraceEx2 <https://learn.microsoft.com/en-us/windows/win32/api/evntrace/nf-evntrace-enabletraceex2>"
              },
              "defaultConfiguration": {
                "level": "note"
              },
              "properties": {
                "tags": []
              }
            },
            {
              "id": "edr/etw-opentrace-check",
              "name": "OpenTrace failure checked against the wrong value",
              "shortDescription": {
                "text": "OpenTrace failure checked against the wrong value"
              },
              "fullDescription": {
                "text": "OpenTrace returns INVALID_PROCESSTRACE_HANDLE on failure. Comparing with INVALID_HANDLE_VALUE, NULL or 0 never detects the error (and 0 can be a valid handle on 32-bit), so ProcessTrace is called with a bad handle."
              },
              "helpUri": "https://learn.microsoft.com/en-us/windows/win32/api/evntrace/nf-evntrace-opentracew",
              "help": {
                "text": "Event Tracing for Windows: OpenTraceW <https://learn.microsoft.com/en-us/windows/win32/api/evntrace/nf-evntrace-opentracew>"
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "tags": []
              }
            },
            {
              "id": "ccsp/public-object-acl",
              "name": "Publicly readable cloud object or bucket",
              "shortDescription": {
                "text": "Publicly readable cloud object or bucket"
              },
              "fullDescription": {
                "text": "Publicly readable cloud object or bucket"
              },
              "helpUri": "https://www.isc2.org/certifications/ccsp/ccsp-certification-exam-outline",
              "help": {
                "text": "CCSP Domain 2 — implement data storage security strategies <https://www.isc2.org/certifications/ccsp/ccsp-certification-exam-outline>\nAWS — Blocking public access to Amazon S3 storage <https://docs.aws.amazon.com/AmazonS3/latest/userguide/access-control-block-public-access.html>"
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "tags": [
                  "ccsp-d2-storage"
                ]
              }
            },
            {
              "id": "ccsp/sensitive-in-url",
              "name": "Sensitive value in URL query string",
              "shortDescription": {
                "text": "Sensitive value in URL query string"
              },
              "fullDescription": {
                "text": "Sensitive value in URL query string"
              },
              "helpUri": "https://www.isc2.org/certifications/ccsp/ccsp-certification-exam-outline",
              "help": {
                "text": "CCSP Domain 2 — data loss prevention / data in transit <https://www.isc2.org/certifications/ccsp/ccsp-certification-exam-outline>\nCWE-598: Use of GET Request Method With Sensitive Query Strings <https://cwe.mitre.org/data/definitions/598.html>"
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "tags": [
                  "ccsp-d2-dlp"
                ]
              }
            },
            {
              "id": "pci/tls-verification-disabled",
              "name": "TLS certificate verification disabled",
              "shortDescription": {
                "text": "TLS certificate verification disabled"
              },
              "fullDescription": {
                "text": "Disabling certificate verification removes the protection strong cryptography provides for cardholder data in transit (man-in-the-middle)."
              },
              "helpUri": "https://www.pcisecuritystandards.org/document_library/",
              "help": {
                "text": "PCI DSS 4.2.1 — strong cryptography for PAN transmission over open, public networks <https://www.pcisecuritystandards.org/document_library/>\nCWE-295: Improper Certificate Validation <https://cwe.mitre.org/data/definitions/295.html>"
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "tags": [
                  "pci-4.2.1"
                ]
              }
            },
            {
              "id": "pci/weak-tls-version",
              "name": "TLS below 1.2 allowed",
              "shortDescription": {
                "text": "TLS below 1.2 allowed"
              },
              "fullDescription": {
                "text": "TLS 1.0/1.1 and SSL are not considered strong cryptography."
              },
              "helpUri": "https://www.pcisecuritystandards.org/document_library/",
              "help": {
                "text": "PCI DSS 4.2.1 <https://www.pcisecuritystandards.org/document_library/>\nNIST SP 800-52 Rev. 2 — TLS guidelines <https://csrc.nist.gov/pubs/sp/800/52/r2/final>"
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "tags": [
                  "pci-4.2.1"
                ]
              }
            },
            {
              "id": "pci/cleartext-http",
              "name": "Cleartext HTTP endpoint",
              "shortDescription": {
                "text": "Cleartext HTTP endpoint"
              },
              "fullDescription": {
                "text": "Cleartext HTTP endpoint"
              },
              "helpUri": "https://www.pcisecuritystandards.org/document_library/",
              "help": {
                "text": "PCI DSS 4.2.1 <https://www.pcisecuritystandards.org/document_library/>\nCWE-319: Cleartext Transmission of Sensitive Information <https://cwe.mitre.org/data/definitions/319.html>"
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "tags": [
                  "pci-4.2.1"
                ]
              }
            },
            {
              "id": "pci/weak-crypto",
              "name": "Weak hash or cipher",
              "shortDescription": {
                "text": "Weak hash or cipher"
              },
              "fullDescription": {
                "text": "MD5, SHA-1, DES/3DES, RC4, Blowfish and ECB mode are not strong cryptography for protecting stored or transmitted account data."
              },
              "helpUri": "https://www.pcisecuritystandards.org/document_library/",
              "help": {
                "text": "PCI DSS 3.5.1 / 4.2.1 and the PCI DSS Glossary definition of strong cryptography <https://www.pcisecuritystandards.org/document_library/>\nCWE-327: Use of a Broken or Risky Cryptographic Algorithm <https://cwe.mitre.org/data/definitions/327.html>"
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "tags": [
                  "pci-3.5.1",
                  "pci-4.2.1"
                ]
              }
            },
            {
              "id": "pci/hardcoded-credential",
              "name": "Hard-coded credential",
              "shortDescription": {
                "text": "Hard-coded credential"
              },
              "fullDescription": {
                "text": "Hard-coded credential"
              },
              "helpUri": "https://www.pcisecuritystandards.org/document_library/",
              "help": {
                "text": "PCI DSS 8.6.2 — passwords/passphrases for accounts are not hard coded <https://www.pcisecuritystandards.org/document_library/>\nCWE-798: Use of Hard-coded Credentials <https://cwe.mitre.org/data/definitions/798.html>"
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "tags": [
                  "pci-8.6.2"
                ]
              }
            },
            {
              "id": "pci/pan-literal",
              "name": "Primary account number in source",
              "shortDescription": {
                "text": "Primary account number in source"
              },
              "fullDescription": {
                "text": "Primary account number in source"
              },
              "helpUri": "https://www.pcisecuritystandards.org/document_library/",
              "help": {
                "text": "PCI DSS 3.5.1 — PAN is rendered unreadable anywhere it is stored <https://www.pcisecuritystandards.org/document_library/>"
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "tags": [
                  "pci-3.5.1"
                ]
              }
            },
            {
              "id": "pci/sql-injection",
              "name": "SQL built from strings",
              "shortDescription": {
                "text": "SQL built from strings"
              },
              "fullDescription": {
                "text": "SQL built from strings"
              },
              "helpUri": "https://www.pcisecuritystandards.org/document_library/",
              "help": {
                "text": "PCI DSS 6.2.4 — software engineering techniques prevent common attacks (injection) <https://www.pcisecuritystandards.org/document_library/>\nCWE-89: SQL Injection <https://cwe.mitre.org/data/definitions/89.html>"
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "tags": [
                  "pci-6.2.4"
                ]
              }
            },
            {
              "id": "pci/account-data-logged",
              "name": "Account data written to logs",
              "shortDescription": {
                "text": "Account data written to logs"
              },
              "fullDescription": {
                "text": "PAN or sensitive authentication data (CVV, track data, PIN block) reaches a logging call. Logs are storage: PAN there must be unreadable (PCI DSS 3.5.1) and SAD must not be retained after authorisation (3.3.1). Mask (first 6 / last 4), tokenise or drop the value before logging. Tracks values through local assignments within a function."
              },
              "helpUri": "https://www.pcisecuritystandards.org/document_library/",
              "help": {
                "text": "PCI DSS 3.3.1 (SAD not retained) and 3.5.1 (PAN unreadable where stored) <https://www.pcisecuritystandards.org/document_library/>\nCCSP Domain 2 — data loss prevention <https://www.isc2.org/certifications/ccsp/ccsp-certification-exam-outline>\nCWE-532: Insertion of Sensitive Information into Log File <https://cwe.mitre.org/data/definitions/532.html>"
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "tags": []
              }
            },
            {
              "id": "ccsp/s3-without-sse",
              "name": "Object written without explicit server-side encryption",
              "shortDescription": {
                "text": "Object written without explicit server-side encryption"
              },
              "fullDescription": {
                "text": "S3 encrypts new objects with SSE-S3 by default, but key ownership, rotation and access separation (CCSP Domain 2 key management; PCI DSS 3.6/3.7) require choosing SSE-KMS with a customer-managed key explicitly."
              },
              "helpUri": "https://www.isc2.org/certifications/ccsp/ccsp-certification-exam-outline",
              "help": {
                "text": "CCSP Domain 2 — data storage security, encryption and key management <https://www.isc2.org/certifications/ccsp/ccsp-certification-exam-outline>\nAWS — Protecting data with server-side encryption <https://docs.aws.amazon.com/AmazonS3/latest/userguide/serv-side-encryption.html>"
              },
              "defaultConfiguration": {
                "level": "note"
              },
              "properties": {
                "tags": []
              }
            },
            {
              "id": "ccsp/presigned-url-expiry",
              "name": "Long-lived pre-signed URL",
              "shortDescription": {
                "text": "Long-lived pre-signed URL"
              },
              "fullDescription": {
                "text": "A pre-signed URL is a bearer credential; anyone holding it can read the object until it expires. Keep lifetimes short (minutes) for sensitive data."
              },
              "helpUri": "https://www.isc2.org/certifications/ccsp/ccsp-certification-exam-outline",
              "help": {
                "text": "CCSP Domain 2 — data access controls / data in transit <https://www.isc2.org/certifications/ccsp/ccsp-certification-exam-outline>"
              },
              "defaultConfiguration": {
                "level": "note"
              },
              "properties": {
                "tags": []
              }
            },
            {
              "id": "esp32/unsafe-string-fn",
              "name": "Unbounded string function",
              "shortDescription": {
                "text": "Unbounded string function"
              },
              "fullDescription": {
                "text": "These functions write without a destination size and are the classic source of stack/heap buffer overflows in firmware."
              },
              "helpUri": "https://cwe.mitre.org/data/definitions/120.html",
              "help": {
                "text": "CWE-120: Buffer Copy without Checking Size of Input <https://cwe.mitre.org/data/definitions/120.html>\nESP-IDF — Security Overview <https://docs.espressif.com/projects/esp-idf/en/latest/esp32/security/security.html>"
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "tags": []
              }
            },
            {
              "id": "esp32/unchecked-length",
              "name": "Copy size from caller/packet without bounds check",
              "shortDescription": {
                "text": "Copy size from caller/packet without bounds check"
              },
              "fullDescription": {
                "text": "A length that comes from a parameter or a received structure (`info->len`, `pkt->length`) is used as a copy size with no prior comparison against the destination size — typical in Wi-Fi CSI, ESP-NOW, BLE and USB HID handlers."
              },
              "helpUri": "https://cwe.mitre.org/data/definitions/787.html",
              "help": {
                "text": "CWE-787: Out-of-bounds Write <https://cwe.mitre.org/data/definitions/787.html>\nCWE-130: Improper Handling of Length Parameter Inconsistency <https://cwe.mitre.org/data/definitions/130.html>"
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "tags": []
              }
            },
            {
              "id": "esp32/unchecked-alloc",
              "name": "Allocation result not checked for NULL",
              "shortDescription": {
                "text": "Allocation result not checked for NULL"
              },
              "fullDescription": {
                "text": "Heap is small on MCUs and fragmentation makes allocation failure routine; dereferencing NULL crashes the device (or worse, writes to address 0x0 on some targets)."
              },
              "helpUri": "https://cwe.mitre.org/data/definitions/690.html",
              "help": {
                "text": "CWE-690: Unchecked Return Value to NULL Pointer Dereference <https://cwe.mitre.org/data/definitions/690.html>"
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "tags": []
              }
            },
            {
              "id": "esp32/unchecked-esp-err",
              "name": "Ignored esp_err_t",
              "shortDescription": {
                "text": "Ignored esp_err_t"
              },
              "fullDescription": {
                "text": "ESP-IDF reports failures through `esp_err_t` return values; ignoring them hides initialisation failures (e.g. NVS or Wi-Fi) that leave the device in an undefined state."
              },
              "helpUri": "https://docs.espressif.com/projects/esp-idf/en/latest/esp32/api-guides/error-handling.html",
              "help": {
                "text": "ESP-IDF — Error Handling <https://docs.espressif.com/projects/esp-idf/en/latest/esp32/api-guides/error-handling.html>\nCWE-252: Unchecked Return Value <https://cwe.mitre.org/data/definitions/252.html>"
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "tags": []
              }
            },
            {
              "id": "esp32/format-string",
              "name": "Non-literal format string",
              "shortDescription": {
                "text": "Non-literal format string"
              },
              "fullDescription": {
                "text": "Passing data (for example a received payload) as the format string lets `%n`/`%s` sequences read or write memory."
              },
              "helpUri": "https://cwe.mitre.org/data/definitions/134.html",
              "help": {
                "text": "CWE-134: Use of Externally-Controlled Format String <https://cwe.mitre.org/data/definitions/134.html>"
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "tags": []
              }
            },
            {
              "id": "esp32/isr-unsafe-call",
              "name": "Blocking / non-ISR-safe call in interrupt handler",
              "shortDescription": {
                "text": "Blocking / non-ISR-safe call in interrupt handler"
              },
              "fullDescription": {
                "text": "Interrupt handlers (`IRAM_ATTR` functions or handlers registered with `gpio_isr_handler_add`/`esp_intr_alloc`) must not block, allocate or log through the normal path; use the `FromISR` APIs and defer work to a task."
              },
              "helpUri": "https://docs.espressif.com/projects/esp-idf/en/latest/esp32/api-reference/system/freertos_idf.html",
              "help": {
                "text": "ESP-IDF — FreeRTOS (ISR-safe FromISR APIs) <https://docs.espressif.com/projects/esp-idf/en/latest/esp32/api-reference/system/freertos_idf.html>"
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "tags": []
              }
            },
            {
              "id": "esp32/csi-callback-heavy",
              "name": "Heavy work in Wi-Fi CSI callback",
              "shortDescription": {
                "text": "Heavy work in Wi-Fi CSI callback"
              },
              "fullDescription": {
                "text": "The CSI receive callback runs in the Wi-Fi task. Logging, allocation, I/O or blocking there drops packets and can starve the Wi-Fi stack; copy `info->buf` into a queue and process it in your own task."
              },
              "helpUri": "https://docs.espressif.com/projects/esp-idf/en/latest/esp32/api-guides/wifi.html#wi-fi-channel-state-information",
              "help": {
                "text": "ESP-IDF — Wi-Fi Channel State Information <https://docs.espressif.com/projects/esp-idf/en/latest/esp32/api-guides/wifi.html#wi-fi-channel-state-information>"
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "tags": []
              }
            },
            {
              "id": "esp32/esp-random-entropy",
              "name": "esp_random() without an enabled entropy source",
              "shortDescription": {
                "text": "esp_random() without an enabled entropy source"
              },
              "fullDescription": {
                "text": "The hardware RNG only produces true random numbers while Wi-Fi/Bluetooth RF is running or after `bootloader_random_enable()`; otherwise its output must be treated as pseudo-random. This file never enables a source (it may happen elsewhere — suppress if so)."
              },
              "helpUri": "https://docs.espressif.com/projects/esp-idf/en/latest/esp32/api-reference/system/random.html",
              "help": {
                "text": "ESP-IDF — Random Number Generation <https://docs.espressif.com/projects/esp-idf/en/latest/esp32/api-reference/system/random.html>\nNIST SP 800-90B — Entropy Sources <https://csrc.nist.gov/pubs/sp/800/90/b/final>"
              },
              "defaultConfiguration": {
                "level": "note"
              },
              "properties": {
                "tags": []
              }
            },
            {
              "id": "esp32/insecure-rand",
              "name": "Non-cryptographic PRNG",
              "shortDescription": {
                "text": "Non-cryptographic PRNG"
              },
              "fullDescription": {
                "text": "`rand()`/`random()` are predictable; use `esp_fill_random()` or an mbedTLS/PSA DRBG for keys, nonces and tokens."
              },
              "helpUri": "https://cwe.mitre.org/data/definitions/338.html",
              "help": {
                "text": "CWE-338: Use of Cryptographically Weak PRNG <https://cwe.mitre.org/data/definitions/338.html>\nESP-IDF — Random Number Generation <https://docs.espressif.com/projects/esp-idf/en/latest/esp32/api-reference/system/random.html>"
              },
              "defaultConfiguration": {
                "level": "note"
              },
              "properties": {
                "tags": []
              }
            },
            {
              "id": "esp32/hardcoded-credential",
