{
  "name": "endpoint-security",
  "displayName": "Endpoint Security & Compliance Toolkit",
  "description": "WFP / ETW / macOS Endpoint Security API validation, PCI DSS 4.0.1 & CCSP compliance scanning, and process-tree detection simulation.",
  "version": "0.3.3",
  "publisher": "jest-test-team",
  "license": "MIT",
  "icon": "icon.png",
  "galleryBanner": {
    "color": "#1e1e1e",
    "theme": "dark"
  },
  "keywords": [
    "edr",
    "wfp",
    "etw",
    "endpoint security",
    "pci dss",
    "ccsp",
    "sarif",
    "mitre att&ck"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Jest-Test-Team/ide-extension.git",
    "directory": "extensions/endpoint-security"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Linters",
    "Programming Languages",
    "Other"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onLanguage:c",
    "onLanguage:cpp",
    "onLanguage:rust",
    "onLanguage:objective-c",
    "onLanguage:go",
    "onLanguage:typescript",
    "onLanguage:javascript",
    "workspaceContains:**/*.ptree.yaml"
  ],
  "contributes": {
    "commands": [
      {
        "command": "endpointSecurity.scanWorkspace",
        "title": "Scan Workspace",
        "category": "Endpoint Security"
      },
      {
        "command": "endpointSecurity.exportReport",
        "title": "Export Compliance Report (SARIF / Markdown)\u2026",
        "category": "Endpoint Security"
      },
      {
        "command": "endpointSecurity.simulateScenario",
        "title": "Simulate Process-Tree Scenario",
        "category": "Endpoint Security",
        "icon": "$(play)"
      },
      {
        "command": "endpointSecurity.newScenario",
        "title": "New Process-Tree Scenario",
        "category": "Endpoint Security"
      },
      {
        "command": "endpointSecurity.scanExtensions",
        "title": "Scan Installed Extensions",
        "category": "Endpoint Security",
        "icon": "$(refresh)"
      },
      {
        "command": "endpointSecurity.exportExtensionReport",
        "title": "Export Extension Risk Report (SARIF / Markdown)\u2026",
        "category": "Endpoint Security",
        "icon": "$(save)"
      },
      {
        "command": "endpointSecurity.extensionScan.allowlist",
        "title": "Trust (Allowlist)\u2026",
        "category": "Endpoint Security",
        "icon": "$(verified)"
      },
      {
        "command": "endpointSecurity.extensionScan.unallowlist",
        "title": "Remove from Allowlist",
        "category": "Endpoint Security"
      },
      {
        "command": "endpointSecurity.extensionScan.openInMarketplace",
        "title": "Show Extension Page",
        "category": "Endpoint Security",
        "icon": "$(extensions)"
      },
      {
        "command": "endpointSecurity.extensionScan.revealFolder",
        "title": "Reveal Install Folder",
        "category": "Endpoint Security",
        "icon": "$(folder-opened)"
      },
      {
        "command": "endpointSecurity.extensionScan.updateKnownBadList",
        "title": "Update Known-Bad Extension List",
        "category": "Endpoint Security"
      },
      {
        "command": "endpointSecurity.installCli",
        "title": "Install 'jest-endpoint' Command in PATH",
        "category": "Endpoint Security"
      },
      {
        "command": "endpointSecurity.uninstallCli",
        "title": "Uninstall 'jest-endpoint' Command",
        "category": "Endpoint Security"
      }
    ],
    "configuration": {
      "title": "Endpoint Security & Compliance",
      "properties": {
        "endpointSecurity.apiRules.enable": {
          "type": "boolean",
          "default": true,
          "description": "Validate WFP / ETW / Endpoint Security API usage in C, C++, Objective-C and Rust."
        },
        "endpointSecurity.lintOnType": {
          "type": "boolean",
          "default": true,
          "description": "Lint while typing (otherwise on open and save)."
        },
        "endpointSecurity.disabledRules": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "markdownDescription": "Rule ids to turn off, e.g. `edr/etw-broad-enable`."
        },
        "endpointSecurity.rulePacks": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "markdownDescription": "Additional YAML/JSON rule packs (workspace-relative paths)."
        },
        "endpointSecurity.compliance.enable": {
          "type": "boolean",
          "default": true,
          "description": "Scan Go / TypeScript / JavaScript for PCI DSS 4.0.1 and CCSP Domain 2 issues."
        },
        "endpointSecurity.simulation.useDefaultRules": {
          "type": "boolean",
          "default": true,
          "description": "Include the built-in detection library (MITRE ATT&CK mapped) when simulating."
        },
        "endpointSecurity.simulation.ruleFiles": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "markdownDescription": "Workspace-relative YAML files with additional `rules:` for the simulator."
        },
        "endpointSecurity.simulation.agentUrl": {
          "type": "string",
          "default": "",
          "markdownDescription": "Send simulations to a remote agent (JSON-RPC over HTTP), e.g. one started in a sandbox VM with `node ptreeAgent.js --http 8765`. Empty = local agent process."
        },
        "endpointSecurity.extensionScan.allowlist": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "markdownDescription": "Extensions you trust: `publisher.name` (any version) or `publisher.name@version` (that version only, so an update is scored again). Reasons are still listed. A listing as removed for malware overrides the allowlist."
        },
        "endpointSecurity.extensionScan.trustedPublishers": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "markdownDescription": "Publisher ids to add to the built-in list of well-known publishers (e.g. your company's)."
        },
        "endpointSecurity.extensionScan.includeBuiltin": {
          "type": "boolean",
          "default": false,
          "description": "Also scan the extensions that ship with VS Code."
        },
        "endpointSecurity.extensionScan.includeNodeModules": {
          "type": "boolean",
          "default": true,
          "description": "Scan JavaScript inside extensions' node_modules folders (dependencies run with the same rights)."
        },
        "endpointSecurity.extensionScan.maxFileSizeMB": {
          "type": "number",
          "default": 10,
          "minimum": 1,
          "description": "Skip JavaScript files larger than this (MB). Skipped files are listed as 'Some files were not scanned'."
        },
        "endpointSecurity.extensionScan.maxFilesPerExtension": {
          "type": "number",
          "default": 2000,
          "minimum": 1,
          "description": "Maximum JavaScript files scanned per extension (entry points first, dependencies last)."
        },
        "endpointSecurity.extensionScan.updateKnownBadList": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Before a scan, download Microsoft's [list of removed extensions](https://github.com/microsoft/vsmarketplace/blob/main/RemovedPackages.md) when the local copy is older than a week. Downloads a public file from GitHub; sends nothing about your extensions. Off: the copy bundled with this version is used."
        },
        "endpointSecurity.extensionScan.marketplaceLookup": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "**Sends the identifiers of your installed extensions to Microsoft** (the VS Marketplace) to check publisher verification, install counts and last update. Off by default; everything else in the scan is local."
        }
      }
    },
    "menus": {
      "editor/title": [
        {
          "command": "endpointSecurity.simulateScenario",
          "when": "resourceFilename =~ /\\.ptree\\.ya?ml$/",
          "group": "navigation"
        }
      ],
      "view/title": [
        {
          "command": "endpointSecurity.scanExtensions",
          "when": "view == endpointSecurity.extensions",
          "group": "navigation@1"
        },
        {
          "command": "endpointSecurity.exportExtensionReport",
          "when": "view == endpointSecurity.extensions",
          "group": "navigation@2"
        },
        {
          "command": "endpointSecurity.extensionScan.updateKnownBadList",
          "when": "view == endpointSecurity.extensions",
          "group": "more@1"
        }
      ],
      "view/item/context": [
        {
          "command": "endpointSecurity.extensionScan.openInMarketplace",
          "when": "view == endpointSecurity.extensions && viewItem =~ /^extScan\\.ext/",
          "group": "inline@1"
        },
        {
          "command": "endpointSecurity.extensionScan.revealFolder",
          "when": "view == endpointSecurity.extensions && viewItem =~ /^extScan\\.ext/",
          "group": "inline@2"
        },
        {
          "command": "endpointSecurity.extensionScan.allowlist",
          "when": "view == endpointSecurity.extensions && viewItem == extScan.ext",
          "group": "1_trust@1"
        },
        {
          "command": "endpointSecurity.extensionScan.unallowlist",
          "when": "view == endpointSecurity.extensions && viewItem == extScan.ext.allowlisted",
          "group": "1_trust@2"
        },
        {
          "command": "endpointSecurity.extensionScan.openInMarketplace",
          "when": "view == endpointSecurity.extensions && viewItem =~ /^extScan\\.ext/",
          "group": "2_open@1"
        },
        {
          "command": "endpointSecurity.extensionScan.revealFolder",
          "when": "view == endpointSecurity.extensions && viewItem =~ /^extScan\\.ext/",
          "group": "2_open@2"
        }
      ],
      "commandPalette": [
        {
          "command": "endpointSecurity.extensionScan.allowlist",
          "when": "false"
        },
        {
          "command": "endpointSecurity.extensionScan.unallowlist",
          "when": "false"
        },
        {
          "command": "endpointSecurity.extensionScan.openInMarketplace",
          "when": "false"
        },
        {
          "command": "endpointSecurity.extensionScan.revealFolder",
          "when": "false"
        }
      ]
    },
    "yamlValidation": [
      {
        "fileMatch": [
          "*.ptree.yaml",
          "*.ptree.yml"
        ],
        "url": "./dist/ptree/ptree.schema.json"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "endpointSecurity",
          "title": "Endpoint Security",
          "icon": "media/shield.svg"
        }
      ]
    },
    "views": {
      "endpointSecurity": [
        {
          "id": "endpointSecurity.extensions",
          "name": "Installed Extensions",
          "icon": "media/shield.svg"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "endpointSecurity.extensions",
        "contents": "Score every installed extension for risk signals: startup activation, process execution, credential paths, exfiltration endpoints, obfuscation, look-alike names and Microsoft's list of removed extensions.\nThe scan is read-only and runs locally.\n[Scan Installed Extensions](command:endpointSecurity.scanExtensions)"
      }
    ]
  },
  "scripts": {
    "build": "node ../../scripts/build-extension.mjs",
    "watch": "node ../../scripts/build-extension.mjs --watch",
    "vscode:prepublish": "node ../../scripts/build-extension.mjs --production",
    "test:integration": "npm run build && tsc -p tsconfig.test.json && vscode-test",
    "package": "node -e \"require('fs').mkdirSync('../../vsix',{recursive:true})\" && vsce package --no-dependencies --out ../../vsix/"
  },
  "devDependencies": {
    "@ide-ext/core": "*"
  },
  "x-build": {
    "copy": [
      {
        "from": "pkg:web-tree-sitter/tree-sitter.wasm",
        "to": "grammars/tree-sitter.wasm"
      },
      {
        "from": "pkg:tree-sitter-c/tree-sitter-c.wasm",
        "to": "grammars/tree-sitter-c.wasm"
      },
      {
        "from": "pkg:tree-sitter-cpp/tree-sitter-cpp.wasm",
        "to": "grammars/tree-sitter-cpp.wasm"
      },
      {
        "from": "pkg:tree-sitter-rust/tree-sitter-rust.wasm",
        "to": "grammars/tree-sitter-rust.wasm"
      },
      {
        "from": "pkg:tree-sitter-go/tree-sitter-go.wasm",
        "to": "grammars/tree-sitter-go.wasm"
      },
      {
        "from": "pkg:tree-sitter-typescript/tree-sitter-typescript.wasm",
        "to": "grammars/tree-sitter-typescript.wasm"
      },
      {
        "from": "pkg:tree-sitter-typescript/tree-sitter-tsx.wasm",
        "to": "grammars/tree-sitter-tsx.wasm"
      },
      {
        "from": "data/rules",
        "to": "rules"
      },
      {
        "from": "data/ptree",
        "to": "ptree"
      },
      {
        "from": "data/extscan",
        "to": "extscan"
      }
    ],
    "nodeEntries": {
      "ptreeAgent": "src/ptree/agentMain.ts",
      "extScanWorker": "src/extscan/worker.ts",
      "cli/jest-endpoint": "../../packages/cli/src/bin/jest-endpoint.ts"
    },
    "webEntries": {
      "ptree": "src/web/ptree.ts"
    }
  },
  "dependencies": {
    "yaml": "^2.9.1"
  }
}
