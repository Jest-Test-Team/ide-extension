   "doc": "Registers a callout (kernel mode, FWPS_CALLOUT0).",
   "url": "https://learn.microsoft.com/en-us/windows-hardware/drivers/ddi/fwpsk/nf-fwpsk-fwpscalloutregister0",
   "irql": "PASSIVE_LEVEL",
   "pairedWith": "FwpsCalloutUnregisterById0"
