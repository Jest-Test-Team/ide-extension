 ],
 "constants": [
  {
   "name": "FWPM_SESSION_FLAG_DYNAMIC",
   "doc": "Objects added in the session are deleted when it ends."
  },
  {
   "name": "FWPM_TXN_READ_ONLY",
   "doc": "Read-only transaction flag for FwpmTransactionBegin0."
  },
  {
   "name": "FWP_ACTION_BLOCK",
   "doc": "Filter action: block."
  },
  {
   "name": "FWP_ACTION_PERMIT",
   "doc": "Filter action: permit."
  },
  {
   "name": "FWP_ACTION_CALLOUT_TERMINATING",
   "doc": "Callout that always returns permit or block."
  },
  {
   "name": "FWP_ACTION_CALLOUT_INSPECTION",
   "doc": "Callout that never blocks (inspection only)."
  },
  {
   "name": "FWPM_LAYER_ALE_AUTH_CONNECT_V4",
