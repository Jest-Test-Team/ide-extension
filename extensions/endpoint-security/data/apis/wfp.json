    },
    {
     "name": "calloutId",
     "type": "UINT32 *",
     "doc": "Receives the runtime callout id."
    }
   ],
   "doc": "Registers a callout (kernel mode, FWPS_CALLOUT1).",
   "url": "https://learn.microsoft.com/en-us/windows-hardware/drivers/ddi/fwpsk/nf-fwpsk-fwpscalloutregister1",
   "irql": "PASSIVE_LEVEL",
   "pairedWith": "FwpsCalloutUnregisterById0"
