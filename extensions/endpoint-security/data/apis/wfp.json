  },
  {
   "name": "FWPM_LAYER_ALE_AUTH_CONNECT_V6",
   "doc": "Outbound connect authorization (IPv6)."
  },
  {
   "name": "FWPM_LAYER_ALE_AUTH_RECV_ACCEPT_V4",
   "doc": "Inbound accept authorization (IPv4)."
  },
  {
   "name": "FWPM_LAYER_ALE_AUTH_RECV_ACCEPT_V6",
   "doc": "Inbound accept authorization (IPv6)."
  },
  {
   "name": "FWPM_LAYER_ALE_FLOW_ESTABLISHED_V4",
   "doc": "Notification when a flow is established (IPv4)."
  },
  {
   "name": "FWPM_LAYER_STREAM_V4",
   "doc": "TCP stream data (IPv4)."
  }
 ]
