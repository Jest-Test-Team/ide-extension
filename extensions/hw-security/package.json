{
  "name": "hw-security",
  "displayName": "Embedded Hardware Security Workbench",
  "description": "ESP32 firmware security linter, NIST SP 800-90B entropy & PUF analysis, and ChipWhisperer side-channel tags.",
  "version": "0.1.0",
  "publisher": "jest-test-team",
  "license": "MIT",
  "repository": { "type": "git", "url": "https://github.com/Jest-Test-Team/ide-extension.git", "directory": "extensions/hw-security" },
  "engines": { "vscode": "^1.90.0" },
  "categories": ["Linters", "Visualization", "Programming Languages"],
  "main": "./dist/extension.js",
  "activationEvents": [],
  "contributes": {
    "commands": [
      { "command": "hwSecurity.hello", "title": "Hello", "category": "Embedded Hardware Security Workbench" }
    ]
  },
  "scripts": {
    "build": "node ../../scripts/build-extension.mjs",
    "watch": "node ../../scripts/build-extension.mjs --watch",
    "vscode:prepublish": "node ../../scripts/build-extension.mjs --production",
    "test:integration": "npm run build && tsc -p tsconfig.test.json && vscode-test",
    "package": "node -e \"require('fs').mkdirSync('../../vsix',{recursive:true})\" && vsce package --no-dependencies --out ../../vsix/"
  },
  "devDependencies": {
    "@ide-ext/core": "*"
  }
}
