{
  "name": "hw-security",
  "displayName": "Embedded Hardware Security Workbench",
  "description": "ESP32 firmware security linter, NIST SP 800-90B entropy & PUF analysis, and ChipWhisperer side-channel tags.",
  "version": "0.1.0",
  "publisher": "jest-test-team",
  "license": "MIT",
  "icon": "icon.png",
  "galleryBanner": {
    "color": "#1e1e1e",
    "theme": "dark"
  },
  "keywords": [
    "esp32",
    "esp-idf",
    "esphome",
    "entropy",
    "sp 800-90b",
    "puf",
    "chipwhisperer",
    "side-channel"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Jest-Test-Team/ide-extension.git",
    "directory": "extensions/hw-security"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Linters",
    "Visualization",
    "Programming Languages"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onLanguage:c",
    "onLanguage:cpp",
    "onLanguage:python",
    "onLanguage:yaml",
    "workspaceContains:**/CMakeLists.txt",
    "workspaceContains:**/sdkconfig"
  ],
  "contributes": {
    "commands": [
      {
        "command": "hwSecurity.scanWorkspace",
        "title": "Scan Workspace (ESP32 / ESPHome)",
        "category": "HW Security"
      },
      {
        "command": "hwSecurity.assessEntropy",
        "title": "Assess Entropy Source (SP 800-90B)\u2026",
        "category": "HW Security"
      },
      {
        "command": "hwSecurity.restartTest",
        "title": "Run Restart Test (SP 800-90B 3.1.4)\u2026",
        "category": "HW Security"
      },
      {
        "command": "hwSecurity.analyzePuf",
        "title": "Analyze PUF Responses\u2026",
        "category": "HW Security"
      },
      {
        "command": "hwSecurity.insertScaTag",
        "title": "Insert Side-Channel Tag",
        "category": "HW Security"
      },
      {
        "command": "hwSecurity.refreshSca",
        "title": "Refresh Side-Channel Points",
        "category": "HW Security",
        "icon": "$(refresh)"
      },
      {
        "command": "hwSecurity.installCli",
        "title": "Install 'jest-hw / jest-embedded' Command in PATH",
        "category": "HW Security"
      },
      {
        "command": "hwSecurity.uninstallCli",
        "title": "Uninstall 'jest-hw / jest-embedded' Command",
        "category": "HW Security"
      }
    ],
    "configuration": {
      "title": "Embedded Hardware Security",
      "properties": {
        "hwSecurity.lint.enable": {
          "type": "boolean",
          "default": true,
          "description": "Run the ESP32 / ESPHome firmware security linter."
        },
        "hwSecurity.lint.onType": {
          "type": "boolean",
          "default": true,
          "description": "Lint while typing (otherwise on open and save)."
        },
        "hwSecurity.lint.disabledRules": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "markdownDescription": "Rule ids to turn off, e.g. `esp32/insecure-rand`."
        },
        "hwSecurity.lint.rulePacks": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "markdownDescription": "Additional YAML/JSON rule packs (workspace-relative paths) using the same schema as the built-in rules."
        },
        "hwSecurity.nist.eaNonIidPath": {
          "type": "string",
          "default": "",
          "scope": "machine-overridable",
          "markdownDescription": "Optional path to NIST's `ea_non_iid` binary ([SP800-90B_EntropyAssessment](https://github.com/usnistgov/SP800-90B_EntropyAssessment)). When set, assessments of binary files are cross-checked against it."
        },
        "hwSecurity.restart.simulationRounds": {
          "type": "number",
          "default": 200000,
          "minimum": 1000,
          "description": "Monte-Carlo rounds for the restart sanity-check cutoff (NIST ea_restart uses 5,000,000)."
        },
        "hwSecurity.puf.eccBlockBits": {
          "type": "number",
          "default": 255,
          "minimum": 1,
          "description": "Block length n of the error-correcting code used for key reconstruction (e.g. 255 for BCH(255,k,t))."
        },
        "hwSecurity.puf.targetFailureRate": {
          "type": "number",
          "default": 1e-06,
          "description": "Target key-reconstruction failure rate per block."
        }
      }
    },
    "menus": {
      "explorer/context": [
        {
          "command": "hwSecurity.assessEntropy",
          "when": "resourceExtname =~ /^\\.(bin|dat|raw)$/",
          "group": "hwSecurity@1"
        },
        {
          "command": "hwSecurity.restartTest",
          "when": "resourceExtname =~ /^\\.(bin|dat|raw)$/",
          "group": "hwSecurity@2"
        },
        {
          "command": "hwSecurity.analyzePuf",
          "when": "resourceExtname == .csv",
          "group": "hwSecurity@3"
        }
      ],
      "view/title": [
        {
          "command": "hwSecurity.refreshSca",
          "when": "view == hwSecurity.scaPoints",
          "group": "navigation"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "hwSecurity",
          "title": "HW Security",
          "icon": "media/chip.svg"
        }
      ]
    },
    "views": {
      "hwSecurity": [
        {
          "id": "hwSecurity.scaPoints",
          "name": "Side-Channel Points"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "hwSecurity.scaPoints",
        "contents": "Tag leakage points in firmware with `// @sca(aes-sbox, \"S-box lookup\")` and reference them from ChipWhisperer scripts with `# @sca-ref(aes-sbox)`.\n[Insert Side-Channel Tag](command:hwSecurity.insertScaTag)"
      }
    ]
  },
  "scripts": {
    "build": "node ../../scripts/build-extension.mjs",
    "watch": "node ../../scripts/build-extension.mjs --watch",
    "vscode:prepublish": "node ../../scripts/build-extension.mjs --production",
    "test:integration": "npm run build && tsc -p tsconfig.test.json && vscode-test",
    "package": "node -e \"require('fs').mkdirSync('../../vsix',{recursive:true})\" && vsce package --no-dependencies --out ../../vsix/"
  },
  "devDependencies": {
    "@ide-ext/core": "*"
  },
  "x-build": {
    "copy": [
      {
        "from": "pkg:web-tree-sitter/tree-sitter.wasm",
        "to": "grammars/tree-sitter.wasm"
      },
      {
        "from": "pkg:tree-sitter-c/tree-sitter-c.wasm",
        "to": "grammars/tree-sitter-c.wasm"
      },
      {
        "from": "pkg:tree-sitter-cpp/tree-sitter-cpp.wasm",
        "to": "grammars/tree-sitter-cpp.wasm"
      }
    ],
    "nodeEntries": {
      "entropyWorker": "src/entropy/worker.ts",
      "cli/jest-hw": "../../packages/cli/src/bin/jest-hw.ts"
    },
    "webEntries": {
      "report": "src/web/report.ts"
    }
  }
}
